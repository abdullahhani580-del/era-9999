rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'abdullahhani580@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserData(data) {
      return data.keys().hasAll(['userId']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 10)) &&
        (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 10)) &&
        (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 100)) &&
        (!('profile' in data) || (data.profile is map)) &&
        (!('scheduleResult' in data) || (data.scheduleResult == null || data.scheduleResult is map)) &&
        (!('highScores' in data) || (data.highScores is map)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
        (!('lastActiveAt' in data) || (data.lastActiveAt is number)) &&
        (!('isOnline' in data) || (data.isOnline is bool));
    }

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == userId &&
        isValidUserData(incoming());

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == existing().userId &&
        isValidUserData(incoming());

      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['message', 'createdAt']) &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100)) &&
        (!('senderEmail' in data) || (data.senderEmail is string && data.senderEmail.size() <= 200)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 200)) &&
        (!('targetEmail' in data) || (data.targetEmail is string && data.targetEmail.size() <= 200)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 4000)) &&
        (!('repliedAt' in data) || (data.repliedAt is string && data.repliedAt.size() <= 50));
    }

    match /support_tickets/{ticketId} {
      allow create: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming());
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt']) &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('version' in data) || (data.version is string && data.version.size() <= 50)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 50));
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming());
    }
  }
}
